{
  "id": "apollo_17",
  "title": "Apollo 17 - CSM America, LM Challenger",
  "data_version": 1,
  "_comment": "Apollo 17, Taurus-Littrow: the final Apollo lunar mission, launched at night on AS-512; Challenger landed in the Taurus-Littrow valley on Luminary 210's targets, met America by a direct rendezvous, TPI in its first revolution, and TEI brought the crew home after three days on the Moon. Sources: the Apollo 17 Mission Report (MSC-07545), the Saturn V flight evaluation report for AS-512 (MPR-SAT-FE-73-1), the LGC's final erasable load (Luminary 210), the final flight plan and press kit, the Apollo Flight Journal's and the Apollo Lunar Surface Journal's transcripts, and LROC's maps of the site. Distances in km, times in GET seconds or hhh:mm:ss. GET counts from range zero, 05:33:00 UTC on 7 December 1972; the flight moved its clocks 2 h 40 min ahead at 65:00:00, and every time here after that is taken back to range zero [simplified: the simulator's clocks aren't moved].",
  "liftoff_jd": 2441658.73125,
  "call_signs": {
    "mission": "Apollo 17",
    "csm": "America",
    "lm": "Challenger",
    "lm_landed": "Taurus-Littrow",
    "_comment": "The call signs CAPCOM used for the flight and its vehicles, Challenger on the surface as Taurus-Littrow (Apollo Lunar Surface Journal) [published]"
  },
  "start_calls": {
    "launch": "T-minus 20 seconds and counting. 15, 14, 13, 12, 11, 10, 9, ignition sequence start.",
    "translunar_coast": "{mission}, Houston. Good TLI. You are on a hybrid trajectory; the midcourse corrections will put you on your lunar orbit plane.",
    "lunar_orbit": "{mission}, Houston. You are on the descent orbit, 60 by 10 miles, with {lm} docked. Undocking comes on the twelfth rev.",
    "lunar_descent": "{lm}, Houston. You are on the descent orbit. Your state vector and Go for PDI are coming, and a Noun 69 after throttle-up.",
    "lunar_surface": "{lm_landed}, Houston. You're Stay. {csm}'s plane change comes first; the ascent PAD at {ascent_pad}.",
    "lunar_ascent": "{lm}, Houston. Your ascent PAD is in, for the direct rendezvous: liftoff at {liftoff}. P12 when you are ready.",
    "tei": "{csm}, Houston. The LM is gone, the subsatellite is out, and your TEI PAD is on its way up.",
    "transearth_coast": "Houston: TEI was good. Your midcourse PADs will come up to trim the entry corridor.",
    "entry": "Houston: entry interface in about twenty minutes. P61, CM/SM SEP when P62 asks, ELS LOGIC and AUTO.",
    "_comment": "CAPCOM's word as each start phase begins, the simulator's own [adapted]"
  },
